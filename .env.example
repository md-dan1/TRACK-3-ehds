# Copy to .env (gitignored, never commit it). Only request text is ever sent to the LLM.

# LLM endpoint type (must return logprobs):
#   OPENROUTER                OpenRouter (default model qwen/qwen3.8-27b)
#   LOGPROB_LLM_PROVIDER_API  any OpenAI-format API that returns logprobs (OpenAI, vLLM, ...)
#   LOCAL_LLM                 local llama.cpp container, GGUF model in ./models, no key;
#                             also set COMPOSE_PROFILES=local
ENDPOINT_TYPE=OPENROUTER
# COMPOSE_PROFILES=local
# LOCAL_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# Empty = default of the endpoint type
LLM_BASE_URL=
LLM_API_KEY=
# or read the key from a file instead
# LLM_API_KEY_PATH=/path/to/api_key_file
# yes/no scoring model (needs logprobs) and text model (SQL, forms, reasons)
LLM_SCORE_MODEL=
LLM_TEXT_MODEL=

# Sign-in accounts (change outside a demo)
APPLICANT_USERNAME=admin
APPLICANT_PASSWORD=password
STAFF_USERNAME=admin
STAFF_PASSWORD=password
APPLICANT_DISPLAY_NAME=Researcher
STAFF_DISPLAY_NAME=Clinic
# true when served over HTTPS
COOKIE_SECURE=false

# Secure processing environment
SPE_PUBLIC_URL=http://localhost:8090
# shared secret between orchestrator and SPE (change outside a demo)
SPE_SERVICE_TOKEN=dev-spe-token
