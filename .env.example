# Copy to .env (gitignored). Only request text is ever sent to the LLM endpoint.
# Endpoint type (every type must return logprobs):
#   OPENROUTER                OpenRouter (default), qwen/qwen3.8-27b. The key's guardrail must allow this model:
#                             the hackathon team key only allows the organisers' list
#                             (https://docs.healthcare-hackathon.eu/tools.html). openrouter/free returns no logprobs.
#   LOGPROB_LLM_PROVIDER_API  any other OpenAI-format API that returns logprobs (e.g. OpenAI, vLLM).
#   LOCAL_LLM                 local llama.cpp container with a GGUF model in ./models, no key.
#                             Also set COMPOSE_PROFILES=local so the container starts.
ENDPOINT_TYPE=OPENROUTER
# COMPOSE_PROFILES=local
# LOCAL_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# Inference endpoint. Empty: default of the type. A base ending in /v1 is called as <base>/chat/completions,
# any other as <base>/v1/chat/completions.
LLM_BASE_URL=
# API key for that endpoint (team key; never commit this file). Paste it here, then recreate the
# orchestrator container (docker compose up -d) so it picks the key up ...
LLM_API_KEY=
# ... or instead give the path of a file holding the key (mounted as a Docker secret)
# LLM_API_KEY_PATH=/path/to/api_key_file
# Decision heads: one-token yes/no with logprobs.
# Models: empty = default of the type (OpenRouter: qwen/qwen3.8-27b, provider: gpt-4o-mini).
# With the hackathon team key set a model from its list, e.g. openai/gpt-5.6-luna or qwen/qwen3-vl-30b-a3b-instruct
LLM_SCORE_MODEL=
# SQL generation, free text -> form (json_schema), reason text
LLM_TEXT_MODEL=

# Sign-in accounts, one per role (defaults: admin / password; change outside a demo)
APPLICANT_USERNAME=admin
APPLICANT_PASSWORD=password
STAFF_USERNAME=admin
STAFF_PASSWORD=password
# names shown in the header and the audit log
APPLICANT_DISPLAY_NAME=Researcher
STAFF_DISPLAY_NAME=Clinic
# set to true when served over HTTPS
COOKIE_SECURE=false

# Secure processing environment instance
# where the researcher's browser reaches it (the "Open SPE" link points here)
SPE_PUBLIC_URL=http://localhost:8090
# shared secret between orchestrator and SPE instance (change outside a demo)
SPE_SERVICE_TOKEN=dev-spe-token
